# Build artifacts
build/
dist/
*.egg-info/
.eggs/
docs/_build/

# Bytecode
__pycache__/
*.py[cod]

# Test / tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# The pinned LDSC binary, when the default cache lands in-tree
.ldsc-cache/

# Snakemake's own run metadata -- most of it lands under workflow/Snakefile's own
# workdir: (docs/tutorials/), but its top-level CLI log lands at the invocation
# directory (the repo root) regardless of workdir:.
docs/tutorials/.snakemake/
/.snakemake/

# pbmc.ipynb tutorial data: all regeneratable, none of it belongs in git (purged
# from history 2026-09-30).
docs/tutorials/data/

# Editors, OS
.vscode/
.idea/
.DS_Store
