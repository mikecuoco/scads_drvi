# Build artifacts
build/
dist/
*.egg-info/
.eggs/

# Bytecode
__pycache__/
*.py[cod]

# Test / tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# The pinned LDSC binary, when the default cache lands in-tree
.ldsc-cache/

# The fetched smoke dataset, when the cache lands in-tree (as it does in CI)
.smoke-cache/

# Local environments. uv writes a self-ignoring .gitignore inside each of these, so this
# is belt and braces for anything that creates one another way.
.venv/
.venv-*/

# Executed notebook copies. The source .ipynb and its paired .py are committed; the
# executed copy is regenerated by `jupyter nbconvert --execute` and is what carries the
# outputs, so committing it would put a large, unreviewable diff in every run's way.
*.out.ipynb

# Figures a notebook writes with viz.save.save_figure. Same reasoning: regenerated on
# every execution, so committing them is ~1 MB of binary churn per run. The inputs under
# notebooks/results/ ARE committed -- those are what the notebook reads and cannot
# reproduce.
notebooks/results/figures/

# Editors, OS
.vscode/
.idea/
.DS_Store
